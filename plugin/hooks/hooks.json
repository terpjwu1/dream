{
  "description": "dream plugin — ambient background dreaming over session transcripts",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/trigger.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
